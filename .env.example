# Copy to .env and adjust.

# --- Postgres (Orthanc index + future app DB) ---
POSTGRES_USER=radiolinq
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=orthanc

# --- Orthanc ---
ORTHANC_USERNAME=radiolinq
ORTHANC_PASSWORD=change-me-orthanc
# Port exposed on the host for the Orthanc Explorer / DICOMweb
ORTHANC_HTTP_PORT=8042
# DICOM (C-STORE) port
ORTHANC_DICOM_PORT=4242

# --- API (NestJS proxy) ---
API_PORT=3000
# Where the API reaches Orthanc (inside the compose network)
ORTHANC_URL=http://orthanc:8042

# --- Web (Vite) ---
WEB_PORT=5173
# Base the browser uses to reach the API
VITE_API_BASE=http://localhost:3000
